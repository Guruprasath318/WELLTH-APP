### Environment variables for WELLTH APP backend
# Copy this file to `.env` and replace values for production.

# Strong random secret for JWT signing (DO NOT commit your real secret)
JWT_SECRET=replace_this_with_a_strong_random_value

# Server port
PORT=3001

# Comma-separated list of allowed CORS origins for production
# Example: http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173
# Server Configuration
PORT=3001

# JWT Secret (REQUIRED - change this to a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database
DB_PATH=./database.db