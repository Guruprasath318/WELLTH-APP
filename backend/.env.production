# WELLTH APP - Production Environment Configuration
# ⚠️ CRITICAL: Change these values for production deployment

# Server Configuration
NODE_ENV=production
PORT=3001

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 32)
# IMPORTANT: Use a strong, random secret key. Example:
# JWT_SECRET=$(openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECURE_KEY_USE_OPENSSL_RAND

# Database Path
DB_PATH=./database.db

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# API Configuration
API_VERSION=v1
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/server.log
