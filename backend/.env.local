# WELLTH APP - Development Environment
# DO NOT commit this file to version control in production

NODE_ENV=development
PORT=3001

# JWT Secret (Development only - use weak secret)
JWT_SECRET=wellth-dev-secret-change-in-production

# Database Path
DB_PATH=./database.db

# CORS Configuration (Allow all for development)
CORS_ORIGIN=*

# API Configuration
API_VERSION=v1
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/server.log
